FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Generate a long random value. In a private chat, send:
# /codex bind <this-token>
FEISHU_BOOTSTRAP_TOKEN=change-me
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOW_GROUP=false

CODEX_PROJECTS_FILE=config/projects.json
CODEX_EXECUTABLE=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_SECONDS=3600
CODEX_MAX_QUEUE=10
CODEX_MAX_REPLY_CHARS=3500
CODEX_SYNC_INTERVAL_SECONDS=2
CODEX_SYNC_BACKFILL_TURNS=1
CODEX_LOG_LEVEL=INFO
